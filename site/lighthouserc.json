{
  "$comment": "Lighthouse budgets (CONTRACT §16, blueprint C7), read by tools/lighthouse.mjs (median of 3, mobile) and in the shape @lhci/cli understands. Every URL is a C1 template page.",
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "url": [
        "/",
        "/services/",
        "/services/irrigation/",
        "/commercial/",
        "/areas/",
        "/areas/oak-bay/",
        "/projects/",
        "/projects/oak-bay-front-garden-renewal/",
        "/process/",
        "/about/",
        "/reviews/",
        "/contact/",
        "/resources/irrigation-start-up-and-winterization/",
        "/free-quote/",
        "/404.html"
      ],
      "settings": { "formFactor": "mobile" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
        "categories:best-practices": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
        "categories:seo": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 1800, "aggregationMethod": "median-run" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05, "aggregationMethod": "median-run" }],
        "total-blocking-time": ["error", { "maxNumericValue": 150, "aggregationMethod": "median-run" }]
      }
    }
  },
  "rnc": {
    "$comment": "tools/lighthouse.mjs extras: warn below warnScore; refuse to judge (exit 2) when the machine's median benchmarkIndex is below minBenchmarkIndex, so a busy machine never fails or passes a page; showcase builds are noindex (is-crawlable) and have no [DOMAIN], so their canonical is relative by CONTRACT §3 (canonical); both audits are skipped there and run in launch builds.",
    "warnScore": 0.98,
    "minBenchmarkIndex": 600,
    "showcaseSkipAudits": ["is-crawlable", "canonical"]
  }
}
