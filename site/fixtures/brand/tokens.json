      "$extensions": {
        "ca.rnc.solid": "#13211A"
      }
    },
    "media-strong": {
      "$value": "rgba(9, 17, 12, 0.56)",
      "$extensions": {
        "ca.rnc.solid": "#0F1C15"
      }
    }
