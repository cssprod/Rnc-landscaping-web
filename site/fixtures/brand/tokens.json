    "ultrathin": {
      "$value": "rgba(255, 255, 255, 0.34)",
      "$extensions": {
        "ca.rnc.dark": "rgba(30, 38, 33, 0.34)",
        "ca.rnc.solid": "#FFFFFF"
      }
    },
    "thin": {
