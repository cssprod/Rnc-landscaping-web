  "glass": {
    "rim": {
      "$type": "color",
      "$value": "rgba(255, 255, 255, 0.85)",
      "$description": "Specular top edge, drawn as an inset highlight.",
      "$extensions": {
        "ca.rnc.dark": "rgba(255, 255, 255, 0.16)"
      }
    },
    "rim-media": {
      "$type": "color",
      "$value": "rgba(255, 255, 255, 0.32)",
      "$description": "Specular edge on dark glass over photos."
    },
    "edge": {
      "$type": "color",
      "$value": "rgba(14, 22, 17, 0.09)",
      "$description": "Outer hairline that defines glass on light backgrounds.",
      "$extensions": {
        "ca.rnc.dark": "rgba(0, 0, 0, 0.55)"
