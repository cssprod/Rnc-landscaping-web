      "$value": {
        "value": 44,
        "unit": "px"
      }
    },
    "saturate": {
      "$type": "number",
      "$value": 1.8
    },
    "sheen": {
      "$type": "gradient",
      "$value": [
        {
          "color": "rgba(255, 255, 255, 0.60)",
          "position": 0
        },
        {
          "color": "rgba(255, 255, 255, 0.10)",
          "position": 0.38
        },
        {
          "color": "rgba(255, 255, 255, 0)",
          "position": 0.62
        }
      ],
      "$extensions": {
        "ca.rnc.css": "linear-gradient(180deg, rgba(255,255,255,.60) 0%, rgba(255,255,255,.10) 38%, rgba(255,255,255,0) 62%)",
        "ca.rnc.dark": "linear-gradient(180deg, rgba(255,255,255,.09) 0%, rgba(255,255,255,.02) 38%, rgba(255,255,255,0) 62%)"
      }
    },
    "sheen-media": {
      "$type": "gradient",
      "$value": [
        {
          "color": "rgba(255, 255, 255, 0.20)",
          "position": 0
        },
        {
          "color": "rgba(255, 255, 255, 0)",
          "position": 0.6
        }
      ],
      "$extensions": {
        "ca.rnc.css": "linear-gradient(180deg, rgba(255,255,255,.20) 0%, rgba(255,255,255,0) 60%)"
      }
    },
    "shadow": {
      "$type": "shadow",
      "$value": [
        {
          "color": "rgba(10, 20, 14, 0.06)",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 1,
            "unit": "px"
          },
          "blur": {
            "value": 2,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        },
        {
          "color": "rgba(10, 20, 14, 0.20)",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 12,
            "unit": "px"
          },
          "blur": {
            "value": 32,
            "unit": "px"
          },
          "spread": {
            "value": -12,
            "unit": "px"
          }
        }
      ],
      "$extensions": {
        "ca.rnc.css": "inset 0 1px 0 0 {glass.rim}, inset 0 -1px 0 0 rgba(255,255,255,.08), 0 0 0 .5px {glass.edge}, 0 1px 2px rgba(10,20,14,.06), 0 12px 32px -12px rgba(10,20,14,.22)",
        "ca.rnc.dark": "inset 0 1px 0 0 {glass.rim}, inset 0 -1px 0 0 rgba(255,255,255,.04), 0 0 0 .5px {glass.edge}, 0 1px 2px rgba(0,0,0,.4), 0 14px 36px -12px rgba(0,0,0,.6)"
      }
    },
    "shadow-media": {
      "$type": "shadow",
      "$value": [
        {
          "color": "rgba(0, 0, 0, 0.30)",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 10,
            "unit": "px"
          },
          "blur": {
            "value": 30,
            "unit": "px"
          },
          "spread": {
            "value": -10,
            "unit": "px"
          }
        }
      ],
      "$extensions": {
        "ca.rnc.css": "inset 0 1px 0 0 {glass.rim-media}, inset 0 -1px 0 0 rgba(255,255,255,.06), 0 0 0 .5px rgba(255,255,255,.12), 0 10px 30px -10px rgba(0,0,0,.35)"
      }
    }
