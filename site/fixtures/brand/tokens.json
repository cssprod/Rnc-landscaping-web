{
  "$description": "RNC Landscaping design tokens: the 'Liquid Glass' system. Format: W3C Design Tokens (DTCG). Light values live in $value; dark-appearance values in $extensions['ca.rnc.dark']; CSS-only expressions (fluid clamp(), composite shadows, gradients) in $extensions['ca.rnc.css']. Generate CSS with: node brand/build-tokens.mjs",
  "$extensions": {
    "ca.rnc.fontFaces": [
      {
        "family": "Inter Variable",
        "src": "/assets/fonts/inter-latin-var.woff2",
        "weight": "400 720",
        "style": "normal",
        "note": "Inter 4 (OFL), latin subset, opsz 14-32 and wght 400-720 axes"
      },
      {
        "family": "Newsreader Variable",
        "src": "/assets/fonts/newsreader-latin-italic-var.woff2",
        "weight": "400 520",
        "style": "italic",
        "note": "Newsreader italic (OFL), latin subset, optical size pinned at 28, wght 400-520"
      }
    ],
    "ca.rnc.fallbacks": [
      {
        "family": "Inter Fallback",
        "local": "Arial",
        "size-adjust": "107.06%",
        "ascent-override": "90.49%",
        "descent-override": "22.56%",
        "line-gap-override": "0%"
      }
    ]
  },
  "color": {
    "$type": "color",
    "bg": {
