{
  "$id": "process.schema.json",
  "title": "content/pages/process.json (new in v3): maintenance and installation tracks, the workmanship guarantee",
  "x-files": ["pages/process.json"],
  "type": "object",
  "required": ["seo", "h1", "lede", "overview", "tracks", "guarantee"],
  "properties": {
    "_notes": { "type": "string" },
    "seo": { "$ref": "_defs.schema.json#/definitions/seo" },
    "h1": { "$ref": "_defs.schema.json#/definitions/text" },
    "lede": { "$ref": "_defs.schema.json#/definitions/text" },
    "overview": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "_defs.schema.json#/definitions/titleBody" } },
    "tracks": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "name", "summary", "steps"],
        "properties": {
          "id": { "enum": ["maintenance", "installation"] },
          "name": { "$ref": "_defs.schema.json#/definitions/text" },
          "summary": { "$ref": "_defs.schema.json#/definitions/text" },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "object", "required": ["title", "body", "deliverable"], "properties": { "title": { "$ref": "_defs.schema.json#/definitions/text" }, "body": { "$ref": "_defs.schema.json#/definitions/text" }, "deliverable": { "$ref": "_defs.schema.json#/definitions/text" } } }
          }
        }
      }
    },
    "guarantee": {
      "type": "object",
      "required": ["heading", "body"],
      "properties": { "heading": { "$ref": "_defs.schema.json#/definitions/text" }, "body": { "type": "array", "minItems": 1, "items": { "$ref": "_defs.schema.json#/definitions/text" } } }
    },
    "sections": { "type": "array", "items": { "$ref": "_defs.schema.json#/definitions/section" } }
  }
}
