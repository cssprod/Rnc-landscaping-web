        "value": 1.5,
        "unit": "rem"
      }
    },
    "6": {
      "$value": {
        "value": 2,
        "unit": "rem"
      }
    },
    "7": {
      "$value": {
        "value": 3,
        "unit": "rem"
      }
    },
    "8": {
      "$value": {
        "value": 4.5,
        "unit": "rem"
      }
    },
    "$type": "dimension",
    "section": {
      "$value": {
        "value": 8,
        "unit": "rem"
      },
      "$description": "Vertical rhythm between page sections.",
      "$extensions": {
        "ca.rnc.css": "clamp(4rem, 2.667rem + 5.926vw, 8rem)"
      }
    }
  },
  "radius": {
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "s": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "m": {
      "$value": {
        "value": 10,
        "unit": "px"
      }
    },
    "l": {
      "$value": {
        "value": 14,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 18,
        "unit": "px"
      }
    },
    "2xl": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "pill": {
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
  "shadow": {
    "1": {
      "$value": [
        {
          "color": "rgba(10, 20, 14, 0.06)",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 1,
            "unit": "px"
          },
          "blur": {
            "value": 2,
            "unit": "px"
          },
          "spread": {
