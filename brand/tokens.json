        "ca.rnc.dark": "0 2px 6px rgba(0,0,0,.35), 0 14px 36px -14px rgba(0,0,0,.65)"
      }
    },
    "3": {
      "$value": [
        {
          "color": "rgba(10, 20, 14, 0.30)",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 30,
            "unit": "px"
          },
          "blur": {
