  "motion": {
    "duration": {
      "fast": {
        "$value": {
          "value": 150,
          "unit": "ms"
        }
      },
      "base": {
        "$value": {
          "value": 200,
          "unit": "ms"
        }
      },
      "slow": {
        "$value": {
          "value": 250,
          "unit": "ms"
        },
        "$description": "Upper limit: motion is 150-250 ms, opacity and transform only."
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.32,
          0.72,
          0,
          1
        ],
        "$description": "Sheets and panels."
      },
      "out": {
        "$value": [
          0.22,
          1,
          0.36,
          1
        ],
        "$description": "Entrances."
      }
    }
  },
  "layout": {
    "$type": "dimension",
    "content-max": {
      "$value": {
        "value": 1200,
        "unit": "px"
      }
    },
    "content-wide": {
      "$value": {
        "value": 1440,
        "unit": "px"
      }
    },
    "content-narrow": {
      "$value": {
        "value": 720,
        "unit": "px"
      }
    },
    "gutter": {
      "$value": {
        "value": 2.75,
        "unit": "rem"
      },
      "$extensions": {
        "ca.rnc.css": "clamp(1.25rem, 0.938rem + 1.389vw, 2.25rem)"
      }
    },
    "header-h": {
      "$value": {
        "value": 64,
        "unit": "px"
      },
      "$description": "Sticky header height below 64em (72px above, set in CSS). scroll-padding-top uses it."
    },
    "bar-h": {
      "$value": {
        "value": 64,
        "unit": "px"
      },
      "$description": "Sticky action bar height below 64em, excluding env(safe-area-inset-bottom)."
    },
    "measure": {
      "$value": "65ch",
      "$description": "Body text measure."
    }
  },
  "z": {
    "$type": "number",
    "sticky": {
      "$value": 50
    },
    "header": {
      "$value": 100
    },
    "overlay": {
      "$value": 200
    }
  }
}
