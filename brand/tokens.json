{
  "$description": "RNC Landscaping design tokens: \"Living Coast\". Format: W3C Design Tokens (DTCG). Dark-first (CONTRACT §15): $value is the Fir night (dark) value and is emitted on :root; $extensions[\"ca.rnc.light\"] holds the Pacific dawn (light) value, emitted under :root[data-theme=\"light\"]. $extensions[\"ca.rnc.css\"] is a CSS expression used instead of $value (fluid clamp(), composite shadows, gradients); \"ca.rnc.solid\" is the opaque fallback used under prefers-reduced-transparency and prefers-contrast: more. Compile with: node brand/build-tokens.mjs",
  "$extensions": {
    "ca.rnc.default": "dark",
    "ca.rnc.fontFaces": [
      {
        "family": "Inter Variable",
        "src": "/assets/fonts/inter-latin-var.woff2",
        "weight": "400 720",
        "style": "normal",
        "note": "Inter 4 (OFL), latin subset, opsz 14-32 and wght 400-720 axes",
        "display": "swap",
        "preload": true
      },
      {
        "family": "Newsreader Variable",
        "src": "/assets/fonts/newsreader-latin-italic-var.woff2",
        "weight": "400 520",
        "style": "italic",
        "note": "Newsreader italic (OFL), latin subset, optical size pinned at 28, wght 400-520",
        "display": "optional",
        "preload": true
      }
    ],
    "ca.rnc.fallbacks": [
      {
        "family": "Inter Fallback",
        "local": "Arial",
        "size-adjust": "107.06%",
        "ascent-override": "90.49%",
        "descent-override": "22.56%",
        "line-gap-override": "0%"
      }
    ],
    "ca.rnc.onDeep": [
      "color.ink",
      "color.ink-2",
      "color.ink-3",
      "color.line",
      "color.line-strong",
      "color.brand",
      "color.brand-hover",
      "color.brand-ink",
      "color.brand-2",
      "color.placeholder",
      "color.placeholder-bg",
      "color.success",
      "color.error",
      "focus.ring",
      "focus.halo",
      "focus.glow",
      "glow.moss",
      "glow.sea"
    ]
  },
  "color": {
    "$type": "color",
    "bg": {
      "$value": "#06110C",
      "$description": "Page. Dark: Fir night. Light: Pacific dawn.",
      "$extensions": {
        "ca.rnc.light": "#F2F6F3"
      }
    },
    "bg-elevated": {
      "$value": "#0D1D16",
      "$description": "Fields, menus, solid material fallback.",
      "$extensions": {
        "ca.rnc.light": "#FFFFFF"
      }
    },
    "bg-grouped": {
      "$value": "#030907",
      "$description": "Sunken areas.",
      "$extensions": {
        "ca.rnc.light": "#E7EEEA"
      }
    },
    "bg-tint": {
      "$value": "#0F2A1F",
      "$description": "Chips, quiet fills.",
      "$extensions": {
        "ca.rnc.light": "#DCEBE2"
      }
    },
    "ink": {
      "$value": "#E8F4EC",
      "$description": "Primary text.",
      "$extensions": {
        "ca.rnc.light": "#0C1A13"
      }
    },
    "ink-2": {
      "$value": "#B2C8BB",
      "$description": "Secondary text.",
      "$extensions": {
        "ca.rnc.light": "#3E5047"
      }
    },
    "ink-3": {
      "$value": "#9AB3A4",
      "$description": "Tertiary text (meta, spec dt). >= 4.5:1 on every content surface and on regular/thick/chrome over art.",
      "$extensions": {
        "ca.rnc.light": "#4F6157"
      }
    },
    "line": {
      "$value": "rgba(200, 240, 215, 0.12)",
      "$description": "Decorative hairlines only.",
      "$extensions": {
        "ca.rnc.light": "rgba(12, 26, 19, 0.11)"
      }
    },
    "line-strong": {
      "$value": "#5E7D6C",
      "$description": "Field and control borders, >= 3:1. Never used alone to show state.",
      "$extensions": {
        "ca.rnc.light": "#6C7F76"
      }
    },
    "brand": {
      "$value": "#7FEBB0",
      "$description": "Dark: bioluminescent moss. Light: Douglas fir (unchanged). Links, primary buttons, the one display accent phrase.",
      "$extensions": {
        "ca.rnc.light": "#1D4A33"
      }
    },
    "brand-hover": {
      "$value": "#A6F5CA",
      "$extensions": {
        "ca.rnc.light": "#143826"
      }
    },
    "brand-ink": {
      "$value": "#03140B",
      "$extensions": {
        "ca.rnc.light": "#FFFFFF"
      }
    },
    "brand-2": {
      "$value": "#6FE0D2",
      "$description": "Dark: sea-glass. Light: fern. Icons, ticks, contour strokes in UI.",
      "$extensions": {
        "ca.rnc.light": "#2B6E4C"
      }
    },
    "deep": {
      "$value": "#020806",
      "$description": "Fir night band (CTA band, footer). Dark in BOTH themes.",
      "$extensions": {
        "ca.rnc.light": "#0B1F15"
      }
    },
    "deep-2": {
      "$value": "#0A1E16",
      "$extensions": {
        "ca.rnc.light": "#163826"
      }
    },
    "on-deep": {
      "$value": "#FFFFFF"
    },
    "on-deep-2": {
      "$value": "rgba(255, 255, 255, 0.76)",
      "$extensions": {
        "ca.rnc.light": "rgba(255, 255, 255, 0.78)"
      }
    },
    "focus": {
      "$value": "{focus.ring}",
      "$description": "Contract alias of focus.ring (two-tone ring: use focus.ring + focus.halo together)."
    },
    "focus-on-deep": {
      "$value": "{focus.ring-on-deep}",
      "$description": "Contract alias of focus.ring-on-deep."
    },
    "placeholder": {
      "$value": "#F2C462",
      "$extensions": {
        "ca.rnc.light": "#7A5200"
      }
    },
    "placeholder-bg": {
      "$value": "rgba(242, 196, 98, 0.14)",
      "$extensions": {
        "ca.rnc.light": "#FFF3D1"
      }
    },
    "success": {
      "$value": "#74D9A0",
      "$extensions": {
        "ca.rnc.light": "#1C6E3F"
      }
    },
    "error": {
      "$value": "#FF8F85",
      "$extensions": {
        "ca.rnc.light": "#B42318"
      }
    },
    "sky": {
      "$value": "#0A1C26",
      "$description": "Illustration sky anchor.",
      "$extensions": {
        "ca.rnc.light": "#DCE9EC"
      }
    },
    "sun": {
      "$value": "#E4EEF2",
      "$description": "Dark: moon. Light: rising sun.",
      "$extensions": {
        "ca.rnc.light": "#FFE7B8"
      }
    },
    "surface": {
      "$value": "{color.bg-elevated}",
      "$description": "Contract alias."
    },
    "surface-2": {
      "$value": "{color.bg-grouped}",
      "$description": "Contract alias."
    },
    "ink-muted": {
      "$value": "{color.ink-2}",
      "$description": "Contract alias."
    },
    "brand-deep": {
      "$value": "{color.deep}",
      "$description": "Contract alias."
    },
    "accent": {
      "$value": "{color.brand}",
      "$description": "Contract alias: primary CTA fill."
    },
    "accent-ink": {
      "$value": "{color.brand-ink}",
      "$description": "Contract alias."
    },
    "accent-on-deep": {
      "$value": "#9FF2C4",
      "$description": "NEW. Newsreader accent phrase and links on deep bands, both themes."
    }
  },
  "material": {
    "$description": "Liquid Glass materials, named after Apple's material thicknesses. Each is a translucent fill used with a backdrop blur; they turn solid under prefers-reduced-transparency and prefers-contrast: more. ca.rnc.minAlpha is the least fill alpha per theme at which ink, ink-2, ink-3 and brand (white on media) keep 4.5:1 over every art extreme with no blur credited; brand/check-contrast.mjs recomputes it and fails if a fill drops below it.",
    "$type": "color",
    "ultrathin": {
      "$value": "rgba(16, 34, 26, 0.40)",
      "$extensions": {
        "ca.rnc.solid": "#FFFFFF",
        "ca.rnc.light": "rgba(255, 255, 255, 0.40)"
      }
    },
    "thin": {
      "$value": "rgba(12, 28, 21, 0.56)",
      "$extensions": {
        "ca.rnc.solid": "#FFFFFF",
        "ca.rnc.light": "rgba(255, 255, 255, 0.58)"
      }
    },
    "regular": {
      "$value": "rgba(10, 24, 18, 0.80)",
      "$extensions": {
        "ca.rnc.solid": "#FFFFFF",
        "ca.rnc.light": "rgba(255, 255, 255, 0.84)",
        "ca.rnc.minAlpha": {
          "dark": 0.8,
          "light": 0.81
        }
      }
    },
    "thick": {
      "$value": "rgba(8, 20, 15, 0.86)",
      "$extensions": {
        "ca.rnc.solid": "#FFFFFF",
        "ca.rnc.light": "rgba(255, 255, 255, 0.88)",
        "ca.rnc.minAlpha": {
          "dark": 0.79,
          "light": 0.81
        }
      }
    },
    "chrome": {
      "$value": "rgba(7, 18, 13, 0.82)",
      "$extensions": {
        "ca.rnc.solid": "#FFFFFF",
        "ca.rnc.light": "rgba(246, 250, 247, 0.84)",
        "ca.rnc.minAlpha": {
          "dark": 0.79,
          "light": 0.84
        }
      }
    },
    "media": {
      "$value": "rgba(3, 10, 7, 0.58)",
      "$extensions": {
        "ca.rnc.solid": "#13211A",
        "ca.rnc.light": "rgba(9, 17, 12, 0.58)",
        "ca.rnc.minAlpha": {
          "dark": 0.54,
          "light": 0.57
        }
      }
    },
    "media-strong": {
      "$value": "rgba(3, 10, 7, 0.70)",
      "$extensions": {
        "ca.rnc.solid": "#0F1C15",
        "ca.rnc.light": "rgba(9, 17, 12, 0.72)",
        "ca.rnc.minAlpha": {
          "dark": 0.54,
          "light": 0.57
        }
      }
    }
  },
  "glass": {
    "rim": {
      "$value": "rgba(255, 255, 255, 0.10)",
      "$type": "color",
      "$extensions": {
        "ca.rnc.light": "rgba(255, 255, 255, 0.90)"
      }
    },
    "rim-media": {
      "$type": "color",
      "$value": "rgba(255, 255, 255, 0.32)",
      "$description": "Specular edge on dark glass over photos."
    },
    "edge": {
      "$value": "rgba(0, 0, 0, 0.60)",
      "$type": "color",
      "$extensions": {
        "ca.rnc.light": "rgba(12, 26, 19, 0.08)"
      }
    },
    "blur": {
      "$type": "dimension",
      "$value": {
        "value": 16,
        "unit": "px"
      },
      "$description": "Capped at 16px (L1 lab). Real backdrop-filter only on the scrolled header (DESIGN-DIRECTION §7); 0px under reduced transparency / more contrast."
    },
    "blur-strong": {
      "$type": "dimension",
      "$value": "{glass.blur}",
      "$description": "Deprecated alias of glass.blur (capped at 16px). Remove at W3b."
    },
    "saturate": {
      "$type": "number",
      "$value": 1.5
    },
    "sheen": {
      "$value": [
        {
          "color": "rgba(255,255,255,.09)",
          "position": 0
        },
        {
          "color": "rgba(255,255,255,.02)",
          "position": 0.38
        },
        {
          "color": "rgba(255,255,255,0)",
          "position": 0.62
        }
      ],
      "$type": "gradient",
      "$extensions": {
        "ca.rnc.css": "linear-gradient(180deg, rgba(255,255,255,.09) 0%, rgba(255,255,255,.02) 38%, rgba(255,255,255,0) 62%)",
        "ca.rnc.light": "linear-gradient(180deg, rgba(255,255,255,.60) 0%, rgba(255,255,255,.10) 38%, rgba(255,255,255,0) 62%)"
      }
    },
    "sheen-media": {
      "$type": "gradient",
      "$value": [
        {
          "color": "rgba(255, 255, 255, 0.20)",
          "position": 0
        },
        {
          "color": "rgba(255, 255, 255, 0)",
          "position": 0.6
        }
      ],
      "$extensions": {
        "ca.rnc.css": "linear-gradient(180deg, rgba(255,255,255,.20) 0%, rgba(255,255,255,0) 60%)"
      }
    },
    "shadow": {
      "$value": [
        {
          "color": "{glass.rim}",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 1,
            "unit": "px"
          },
          "blur": {
            "value": 0,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          },
          "inset": true
        },
        {
          "color": "rgba(255,255,255,.04)",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": -1,
            "unit": "px"
          },
          "blur": {
            "value": 0,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          },
          "inset": true
        },
        {
          "color": "{glass.edge}",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 0,
            "unit": "px"
          },
          "blur": {
            "value": 0,
            "unit": "px"
          },
          "spread": {
            "value": 0.5,
            "unit": "px"
          }
        },
        {
          "color": "rgba(0,0,0,.4)",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 1,
            "unit": "px"
          },
          "blur": {
            "value": 2,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        },
        {
          "color": "rgba(0,0,0,.6)",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 14,
            "unit": "px"
          },
          "blur": {
            "value": 36,
            "unit": "px"
          },
          "spread": {
            "value": -12,
            "unit": "px"
          }
        }
      ],
      "$type": "shadow",
      "$extensions": {
        "ca.rnc.css": "inset 0 1px 0 0 {glass.rim}, inset 0 -1px 0 0 rgba(255,255,255,.04), 0 0 0 .5px {glass.edge}, 0 1px 2px rgba(0,0,0,.4), 0 14px 36px -12px rgba(0,0,0,.6)",
        "ca.rnc.light": "inset 0 1px 0 0 {glass.rim}, inset 0 -1px 0 0 rgba(255,255,255,.08), 0 0 0 .5px {glass.edge}, 0 1px 2px rgba(10,20,14,.06), 0 12px 32px -12px rgba(10,20,14,.22)"
      }
    },
    "shadow-media": {
      "$type": "shadow",
      "$value": [
        {
          "color": "rgba(0, 0, 0, 0.30)",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 10,
            "unit": "px"
          },
          "blur": {
            "value": 30,
            "unit": "px"
          },
          "spread": {
            "value": -10,
            "unit": "px"
          }
        }
      ],
      "$extensions": {
        "ca.rnc.css": "inset 0 1px 0 0 {glass.rim-media}, inset 0 -1px 0 0 rgba(255,255,255,.06), 0 0 0 .5px rgba(255,255,255,.12), 0 10px 30px -10px rgba(0,0,0,.35)"
      }
    }
  },
