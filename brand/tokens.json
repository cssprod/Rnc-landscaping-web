{
  "$description": "RNC Landscaping design tokens: editorial system (Basalt ink on Sea fog, Douglas fir primary, Liquid Glass on chrome only). Format: W3C Design Tokens (DTCG). Light values live in $value; dark-appearance values in $extensions[ca.rnc.dark]; CSS-only expressions (fluid clamp(), composite shadows) in $extensions[ca.rnc.css]. Generate CSS with: node brand/build-tokens.mjs",
  "$extensions": {
    "ca.rnc.fontFaces": [
      {
        "family": "Inter Variable",
        "src": "/assets/fonts/inter-latin-var.woff2",
        "weight": "400 720",
        "style": "normal",
        "note": "Inter 4 (OFL), latin subset, opsz 14-32 and wght 400-720 axes"
      },
      {
        "family": "Newsreader Variable",
        "src": "/assets/fonts/newsreader-latin-italic-var.woff2",
        "weight": "400 520",
        "style": "italic",
        "note": "Newsreader italic (OFL), latin subset, optical size pinned at 28, wght 400-520"
      }
    ],
    "ca.rnc.fallbacks": [
      {
        "family": "Inter Fallback",
        "local": "Arial",
        "size-adjust": "107.06%",
        "ascent-override": "90.49%",
        "descent-override": "22.56%",
        "line-gap-override": "0%"
      }
    ]
  },
  "color": {
    "$type": "color",
    "bg": {
      "$value": "#F4F6F2",
      "$description": "Sea fog. Page background.",
      "$extensions": {
        "ca.rnc.dark": "#0A0E0C"
      }
    },
    "bg-elevated": {
      "$value": "#FFFFFF",
      "$description": "Cards, inset lists, inputs.",
      "$extensions": {
        "ca.rnc.dark": "#131A16"
      }
    },
    "bg-grouped": {
      "$value": "#EBEFE9",
      "$description": "Lichen. Sunken / grouped background.",
      "$extensions": {
        "ca.rnc.dark": "#070A08"
      }
    },
    "bg-tint": {
      "$value": "#E3EEE6",
      "$description": "Moss mist. Tinted chips and quiet fills.",
      "$extensions": {
        "ca.rnc.dark": "#13241A"
      }
    },
    "ink": {
      "$value": "#0E1611",
      "$description": "Basalt. Primary text. 16.9:1 on bg.",
      "$extensions": {
        "ca.rnc.dark": "#EEF2EE"
      }
    },
    "ink-2": {
      "$value": "#46524A",
      "$description": "Wet granite. Secondary text. 7.5:1 on bg.",
      "$extensions": {
        "ca.rnc.dark": "#B2BDB5"
      }
    },
    "ink-3": {
      "$value": "#5F6B63",
      "$description": "Weathered stone. Tertiary text, 4.8:1 or better on every light surface.",
      "$extensions": {
        "ca.rnc.dark": "#8D9991"
      }
    },
    "line": {
      "$value": "rgba(14, 22, 17, 0.10)",
      "$description": "Hairline separators (decorative only).",
      "$extensions": {
        "ca.rnc.dark": "rgba(238, 242, 238, 0.12)"
      }
    },
    "rule": {
      "$value": "rgba(14, 22, 17, 0.18)",
      "$description": "Hairline rules in the spec-sheet strip and numbered section heads.",
      "$extensions": {
        "ca.rnc.dark": "rgba(238, 242, 238, 0.22)"
      }
    },
    "line-strong": {
      "$value": "#7E8982",
      "$description": "Control borders, 3:1 or better.",
      "$extensions": {
        "ca.rnc.dark": "#6E7B72"
      }
    },
    "brand": {
      "$value": "#1D4A33",
      "$description": "Douglas fir. Links, primary buttons, brand text.",
      "$extensions": {
        "ca.rnc.dark": "#8ED3A6"
      }
    },
    "brand-hover": {
      "$value": "#153826",
      "$extensions": {
        "ca.rnc.dark": "#A9E0BD"
      }
    },
    "brand-ink": {
      "$value": "#FFFFFF",
      "$description": "Text on brand fills.",
      "$extensions": {
        "ca.rnc.dark": "#06140C"
      }
    },
    "brand-2": {
      "$value": "#367A4F",
      "$description": "Fern. Icons, highlights, active indicators.",
      "$extensions": {
        "ca.rnc.dark": "#6CC490"
      }
    },
    "contour": {
      "$value": "#367A4F",
      "$description": "Topographic contour motif (drawn at low opacity).",
      "$extensions": {
        "ca.rnc.dark": "#6CC490"
      }
    },
    "deep": {
      "$value": "#0B1F15",
      "$description": "Fir night. Dark bands and footer.",
      "$extensions": {
        "ca.rnc.dark": "#0C1811"
      }
    },
    "deep-2": {
      "$value": "#163826",
      "$description": "Lighter fir night for gradients on dark bands.",
      "$extensions": {
        "ca.rnc.dark": "#12271B"
      }
    },
    "on-deep": {
      "$value": "#FFFFFF",
      "$description": "Text on dark bands and photos."
    },
    "on-deep-2": {
      "$value": "rgba(255, 255, 255, 0.76)",
      "$description": "Secondary text on dark bands and photos."
    },
    "focus": {
      "$value": "#5A4FCF",
      "$description": "Camas, the violet-blue lily of Garry oak meadows. Focus rings only.",
      "$extensions": {
        "ca.rnc.dark": "#B4ADFF"
      }
    },
    "focus-on-deep": {
      "$value": "#B4ADFF",
      "$description": "Camas tint: focus ring on Fir night bands (footer, CTA, credentials) and dark surfaces in both appearances (>= 3:1 on deep, deep-2 and media scrims).",
      "$extensions": {
        "ca.rnc.dark": "#B4ADFF"
      }
    },
    "focus-halo": {
      "$value": "#0B1F15",
      "$description": "Dark halo drawn outside the focus ring on photos, so the ring keeps 3:1 against the halo and the halo keeps 3:1 against light photo pixels.",
      "$extensions": {
        "ca.rnc.dark": "#06140C"
      }
    },
    "placeholder": {
      "$value": "#7A5200",
      "$description": "Text of [TOKEN] placeholder chips.",
      "$extensions": {
        "ca.rnc.dark": "#F2C462"
      }
    },
    "placeholder-bg": {
      "$value": "#FFF3D1",
      "$extensions": {
        "ca.rnc.dark": "rgba(242, 196, 98, 0.14)"
      }
    },
    "success": {
      "$value": "#1E7442",
      "$extensions": {
        "ca.rnc.dark": "#6FCF97"
      }
    },
    "error": {
      "$value": "#B42318",
      "$extensions": {
        "ca.rnc.dark": "#FF8A80"
      }
    },
    "surface": {
      "$value": "{color.bg-elevated}",
      "$description": "Contract alias."
    },
    "accent": {
      "$value": "{color.brand}",
      "$description": "Contract alias: primary CTA fill."
    }
  },
  "material": {
    "$description": "Liquid Glass materials for chrome only (header, sticky action bar, menus, CTA panels over photos). Content cards are solid. Each is a translucent fill used with a backdrop blur; they turn solid under prefers-reduced-transparency and prefers-contrast: more.",
    "$type": "color",
    "thick": {
      "$value": "rgba(255, 255, 255, 0.84)",
      "$extensions": {
        "ca.rnc.dark": "rgba(19, 26, 22, 0.84)",
        "ca.rnc.solid": "#FFFFFF"
      }
    },
    "chrome": {
      "$value": "rgba(248, 250, 247, 0.72)",
      "$description": "Navigation capsule.",
      "$extensions": {
        "ca.rnc.dark": "rgba(17, 23, 20, 0.70)",
        "ca.rnc.solid": "#F8FAF7"
      }
    },
    "media": {
      "$value": "rgba(9, 17, 12, 0.34)",
      "$description": "Dark glass over photography, in both appearances.",
      "$extensions": {
        "ca.rnc.solid": "#13211A"
      }
    },
    "media-strong": {
      "$value": "rgba(9, 17, 12, 0.6)",
      "$extensions": {
        "ca.rnc.solid": "#0F1C15"
      }
    }
  },
  "glass": {
    "rim": {
      "$type": "color",
      "$value": "rgba(255, 255, 255, 0.85)",
      "$description": "Specular top edge, drawn as an inset highlight.",
      "$extensions": {
        "ca.rnc.dark": "rgba(255, 255, 255, 0.16)"
      }
    },
    "rim-media": {
      "$type": "color",
      "$value": "rgba(255, 255, 255, 0.32)",
      "$description": "Specular edge on dark glass over photos."
    },
    "edge": {
      "$type": "color",
      "$value": "rgba(14, 22, 17, 0.09)",
      "$description": "Outer hairline that defines glass on light backgrounds.",
      "$extensions": {
        "ca.rnc.dark": "rgba(0, 0, 0, 0.55)"
      }
    },
    "blur": {
      "$type": "dimension",
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "blur-strong": {
      "$type": "dimension",
      "$value": {
        "value": 44,
        "unit": "px"
      }
    },
    "saturate": {
      "$type": "number",
      "$value": 1.8
    },
    "shadow": {
      "$type": "shadow",
      "$value": [
        {
          "color": "rgba(10, 20, 14, 0.06)",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 1,
            "unit": "px"
          },
          "blur": {
            "value": 2,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        },
        {
          "color": "rgba(10, 20, 14, 0.20)",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 12,
            "unit": "px"
          },
          "blur": {
            "value": 32,
            "unit": "px"
          },
          "spread": {
            "value": -12,
            "unit": "px"
          }
        }
      ],
      "$extensions": {
        "ca.rnc.css": "inset 0 1px 0 0 {glass.rim}, inset 0 -1px 0 0 rgba(255,255,255,.08), 0 0 0 .5px {glass.edge}, 0 1px 2px rgba(10,20,14,.06), 0 12px 32px -12px rgba(10,20,14,.22)",
        "ca.rnc.dark": "inset 0 1px 0 0 {glass.rim}, inset 0 -1px 0 0 rgba(255,255,255,.04), 0 0 0 .5px {glass.edge}, 0 1px 2px rgba(0,0,0,.4), 0 14px 36px -12px rgba(0,0,0,.6)"
      }
    },
    "shadow-media": {
      "$type": "shadow",
      "$value": [
        {
          "color": "rgba(0, 0, 0, 0.30)",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 10,
            "unit": "px"
          },
          "blur": {
            "value": 30,
            "unit": "px"
          },
          "spread": {
            "value": -10,
            "unit": "px"
          }
        }
      ],
      "$extensions": {
        "ca.rnc.css": "inset 0 1px 0 0 {glass.rim-media}, inset 0 -1px 0 0 rgba(255,255,255,.06), 0 0 0 .5px rgba(255,255,255,.12), 0 10px 30px -10px rgba(0,0,0,.35)"
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Inter Variable",
          "Inter Fallback",
          "-apple-system",
          "BlinkMacSystemFont",
          "Segoe UI",
          "Roboto",
          "Helvetica",
          "Arial",
          "sans-serif"
        ],
        "$description": "Inter with optical sizing: the Display cut is used automatically at headline sizes."
      },
      "serif": {
        "$value": [
          "Newsreader Variable",
          "New York",
          "Iowan Old Style",
          "Georgia",
          "serif"
        ],
        "$description": "Editorial italic for quotations only."
      },
      "display": {
        "$value": "{font.family.sans}",
        "$description": "Contract alias."
      },
      "text": {
        "$value": "{font.family.sans}",
        "$description": "Contract alias."
      }
    },
    "size": {
      "display": {
        "$value": {
          "value": 4.5,
          "unit": "rem"
        },
        "$description": "Display: home hero (2.5 -> 4.5 rem, 360 -> 1280 px viewport).",
        "$extensions": {
          "ca.rnc.css": "clamp(2.5rem, 1.7174rem + 3.4783vw, 4.5rem)"
        }
      },
      "h1": {
        "$value": {
          "value": 3.25,
          "unit": "rem"
        },
        "$description": "Page titles (2.0 -> 3.25 rem).",
        "$extensions": {
          "ca.rnc.css": "clamp(2rem, 1.5109rem + 2.1739vw, 3.25rem)"
        }
      },
      "h2": {
        "$value": {
          "value": 2.25,
          "unit": "rem"
        },
        "$description": "Section headings (1.5 -> 2.25 rem).",
        "$extensions": {
          "ca.rnc.css": "clamp(1.5rem, 1.2065rem + 1.3043vw, 2.25rem)"
        }
      },
      "h3": {
        "$value": {
          "value": 1.5,
          "unit": "rem"
        },
        "$description": "Sub-sections and card titles (1.25 -> 1.5 rem).",
        "$extensions": {
          "ca.rnc.css": "clamp(1.25rem, 1.1522rem + 0.4348vw, 1.5rem)"
        }
      },
      "body": {
        "$value": {
          "value": 1.125,
          "unit": "rem"
        },
        "$description": "Body (1.0625 -> 1.125 rem), line-height 1.6, measure 65ch.",
        "$extensions": {
          "ca.rnc.css": "clamp(1.0625rem, 1.038rem + 0.1087vw, 1.125rem)"
        }
      },
      "lede": {
        "$value": {
          "value": 1.3125,
          "unit": "rem"
        },
        "$extensions": {
          "ca.rnc.css": "clamp(1.125rem, 1.0516rem + 0.3261vw, 1.3125rem)"
        },
        "$description": "Introductions."
      },
      "small": {
        "$value": {
          "value": 0.875,
          "unit": "rem"
        },
        "$description": "Small text, captions, spec-strip labels."
      },
      "caption": {
        "$value": {
          "value": 0.8125,
          "unit": "rem"
        },
        "$description": "Chips and image labels (never body copy)."
      },
      "large-title": {
        "$value": "{font.size.h1}",
        "$description": "Alias of h1 (older name)."
      },
      "title-1": {
        "$value": "{font.size.h2}",
        "$description": "Alias of h2 (older name)."
      },
      "title-2": {
        "$value": "{font.size.h2}",
        "$description": "Alias of h2 (older name)."
      },
      "title-3": {
        "$value": "{font.size.h3}",
        "$description": "Alias of h3 (older name)."
      },
      "subheadline": {
        "$value": {
          "value": 0.9375,
          "unit": "rem"
        }
      },
      "footnote": {
        "$value": "{font.size.small}",
        "$description": "Alias of small (older name)."
      }
    },
    "weight": {
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 600,
        "$description": "Inter ships 400/600/700 only on this site; medium maps to 600."
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      },
      "display": {
        "$value": 700
      }
    },
    "leading": {
      "display": {
        "$value": 1.04
      },
      "title": {
        "$value": 1.12
      },
      "snug": {
        "$value": 1.3
      },
      "body": {
        "$value": 1.6
      }
    },
    "tracking": {
      "$type": "dimension",
      "display": {
        "$value": {
          "value": -0.034,
          "unit": "em"
        }
      },
      "title": {
        "$value": {
          "value": -0.024,
          "unit": "em"
        }
      },
      "headline": {
        "$value": {
          "value": -0.012,
          "unit": "em"
        }
      },
      "body": {
        "$value": {
          "value": -0.006,
          "unit": "em"
        }
      }
    }
  },
  "space": {
    "1": {
      "$value": {
        "value": 0.25,
        "unit": "rem"
      }
    },
    "2": {
      "$value": {
        "value": 0.5,
        "unit": "rem"
      }
    },
    "3": {
